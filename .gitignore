# Build output
/build/
/dist/
*.exe
# `go build ./cmd/csqtt-cli` without -o drops the binary in the repository root.
/csqtt-cli
*.zip
# Rust build directory of the core.
target/

# Configuration and secrets — never into the repository.
profiles.toml
secrets.json

# Local environment
.idea/
.vscode/
*.log

# Claude Code session dumps: working notes, not project code.
/claude-sessions/

# Stage journals, working notes, scripts and run logs — local only (AGENTS.md).
/doc/local/
/doc/runs/
# A roadmap journal is a working note as well: machines, dates, working-tree state.
/doc/roadmap/*/journal*.md
